# Copy to .env for local runs (gitignored).
# For Cursor Cloud Agents do NOT paste these values into chat:
# add BOT_TOKEN and OPENAI_API_KEY as Runtime Secrets in
# https://cursor.com/dashboard/cloud-agents — see docs/tz.md §13.4.

# Telegram
BOT_TOKEN=

# OpenAI-compatible LLM (OpenAI, OpenRouter, Yandex AI Studio, ...)
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# SQLite by default. Example Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/aura_radar?sslmode=disable

# LOG_LEVEL=INFO

# Shared (defaults match docs/tz.md §8.3)
# AURA_CONTEXT_MESSAGES=30
# AURA_MIN_TEXT_LEN=8
# AURA_LLM_TIMEOUT_SEC=20

# Autoradar reactions (frequent)
# AURA_REACT_MIN_CONFIDENCE=0.62
# AURA_REACT_MIN_ABS_DELTA=80
# AURA_REACT_CHAT_COOLDOWN_SEC=12
# AURA_REACT_USER_COOLDOWN_SEC=90
# AURA_REACT_CHAT_DAILY_CAP=80

# Autoradar text interrupts (rare)
# AURA_TEXT_MIN_CONFIDENCE=0.78
# AURA_TEXT_MIN_ABS_DELTA=500
# AURA_TEXT_CHAT_COOLDOWN_SEC=720
# AURA_TEXT_USER_COOLDOWN_SEC=10800
# AURA_TEXT_CHAT_DAILY_CAP=4
